# Aquora Fleet Commander — dashboard config
# Copy to .env and fill in. NEVER commit the real .env (it is gitignored).

# Directory holding the bots' state JSON files.
# On the VPS this is wherever the bots write state (e.g. /root/states or the
# individual /root/bot* dirs symlinked into one folder).
# For a local test, point it at your aquora bakeoff folder.
STATE_DIR=/root/states

# Optional: explicit path to the live kill-switch state file.
# KILL_SWITCH_STATE=/root/killswitch/state.json

# Guard toggles (for display only — reflects how the live fleet is configured)
MARKET_GUARD=on
EVENT_GUARD=on

# ---- Exchange READ-ONLY API keys ----
# Use keys with READ-ONLY / view permissions. This tool never trades, but
# read-only keys mean a leak can't move funds. Leave blank to skip a venue.
BINANCE_API_KEY=
BINANCE_SECRET_KEY=

BYBIT_API_KEY=
BYBIT_SECRET_KEY=

BITGET_API_KEY=
BITGET_SECRET_KEY=
BITGET_PASSPHRASE=

OKX_API_KEY=
OKX_SECRET_KEY=
OKX_PASSPHRASE=

BINGX_API_KEY=
BINGX_SECRET_KEY=

KUCOIN_API_KEY=
KUCOIN_SECRET_KEY=
KUCOIN_PASSPHRASE=
